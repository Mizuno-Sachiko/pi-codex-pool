{
  "name": "pi-codex-pool",
  "version": "0.1.0",
  "description": "Pi extension for multiple ChatGPT Codex accounts and selectable account-pool models",
  "keywords": [
    "pi-package",
    "pi-extension",
    "openai-codex",
    "chatgpt",
    "plus",
    "pro",
    "oauth",
    "failover"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "author": "Mizuno-Sachiko",
  "contributors": [
    "hjanuschka",
    "thelastbodhisattva"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mizuno-Sachiko/pi-codex-pool.git"
  },
  "homepage": "https://github.com/Mizuno-Sachiko/pi-codex-pool",
  "bugs": {
    "url": "https://github.com/Mizuno-Sachiko/pi-codex-pool/issues"
  },
  "pi": {
    "extensions": [
      "./extensions/multi-sub.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint . --error-on-warnings",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "node tests/run-all.mjs",
    "test:runtime": "node tests/fixtures/request-lifecycle.mjs"
  }
}
